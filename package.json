{
  "name": "day-vscode",
  "displayName": "Day",
  "description": "Build and run Day apps (cross-platform native UI in Rust) across one or more targets from VS Code.",
  "version": "0.4.1",
  "publisher": "daybrite",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/daybrite/day-vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "day",
    "rust",
    "cross-platform",
    "native",
    "appkit",
    "gtk",
    "qt"
  ],
  "icon": "media/day-icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/Day.toml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "day",
          "title": "Day",
          "icon": "media/day-icon.svg"
        }
      ]
    },
    "views": {
      "day": [
        {
          "id": "dayTargets",
          "name": "Build & Run",
          "icon": "media/day-icon.svg",
          "contextualTitle": "Day"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dayTargets",
        "contents": "No Day project found in this workspace.\n\nA Day project is a folder containing a [Day.toml](https://daybrite.dev) manifest.\n\n[Refresh](command:day.refresh)"
      }
    ],
    "commands": [
      {
        "command": "day.run",
        "title": "Run Selected Targets",
        "category": "Day",
        "icon": "$(run-all)"
      },
      {
        "command": "day.runTarget",
        "title": "Run",
        "category": "Day",
        "icon": "$(play)"
      },
      {
        "command": "day.build",
        "title": "Build Selected Targets",
        "category": "Day",
        "icon": "$(tools)"
      },
      {
        "command": "day.stop",
        "title": "Stop",
        "category": "Day",
        "icon": "$(debug-stop)"
      },
      {
        "command": "day.stopAll",
        "title": "Stop All",
        "category": "Day",
        "icon": "$(stop-circle)"
      },
      {
        "command": "day.restart",
        "title": "Restart",
        "category": "Day",
        "icon": "$(debug-restart)"
      },
      {
        "command": "day.selectMode",
        "title": "Select Build Mode",
        "category": "Day"
      },
      {
        "command": "day.selectLocale",
        "title": "Select Locale",
        "category": "Day"
      },
      {
        "command": "day.selectScript",
        "title": "Select Dayscript",
        "category": "Day"
      },
      {
        "command": "day.selectProject",
        "title": "Select Project",
        "category": "Day"
      },
      {
        "command": "day.doctor",
        "title": "Doctor (check toolchains)",
        "category": "Day",
        "icon": "$(stethoscope)"
      },
      {
        "command": "day.refresh",
        "title": "Refresh",
        "category": "Day",
        "icon": "$(refresh)"
      },
      {
        "command": "day.selectTargets",
        "title": "Select Targets",
        "category": "Day",
        "icon": "$(checklist)"
      },
      {
        "command": "day.buildTarget",
        "title": "Build Target",
        "category": "Day",
        "icon": "$(tools)"
      },
      {
        "command": "day.setMode",
        "title": "Set Build Mode",
        "category": "Day"
      },
      {
        "command": "day.setLocale",
        "title": "Set Locale",
        "category": "Day"
      },
      {
        "command": "day.setScript",
        "title": "Set Dayscript",
        "category": "Day"
      },
      {
        "command": "day.newProject",
        "title": "New Project…",
        "category": "Day",
        "icon": "$(new-folder)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "day.run",
          "when": "view == dayTargets",
          "group": "navigation@1"
        },
        {
          "command": "day.stopAll",
          "when": "view == dayTargets",
          "group": "navigation@2"
        },
        {
          "command": "day.refresh",
          "when": "view == dayTargets",
          "group": "navigation@3"
        },
        {
          "command": "day.build",
          "when": "view == dayTargets",
          "group": "1_run@1"
        },
        {
          "command": "day.doctor",
          "when": "view == dayTargets",
          "group": "2_tools@1"
        },
        {
          "command": "day.selectProject",
          "when": "view == dayTargets",
          "group": "2_tools@2"
        }
      ],
      "view/item/context": [
        {
          "command": "day.runTarget",
          "when": "view == dayTargets && viewItem == dayTarget",
          "group": "inline@1"
        },
        {
          "command": "day.stop",
          "when": "view == dayTargets && viewItem == dayTargetRunning",
          "group": "inline@1"
        },
        {
          "command": "day.restart",
          "when": "view == dayTargets && viewItem == dayTargetRunning",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "day.runTarget",
          "when": "false"
        },
        {
          "command": "day.stop",
          "when": "false"
        },
        {
          "command": "day.restart",
          "when": "false"
        },
        {
          "command": "day.setMode",
          "when": "false"
        },
        {
          "command": "day.setLocale",
          "when": "false"
        },
        {
          "command": "day.setScript",
          "when": "false"
        },
        {
          "command": "day.buildTarget",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Day",
      "properties": {
        "day.cliPath": {
          "type": "string",
          "default": "day",
          "markdownDescription": "Path to the `day` CLI binary. If it is not found on `PATH` and the workspace is the Day repository (a Cargo workspace with a `day-cli` member), the extension falls back to `cargo run -q -p day-cli --`."
        },
        "day.defaultProfile": {
          "type": "string",
          "enum": [
            "debug",
            "release"
          ],
          "default": "debug",
          "description": "Default build mode for new workspaces."
        },
        "day.defaultLocale": {
          "type": "string",
          "default": "",
          "description": "Default BCP-47 locale passed to `--locale` (empty = the app/system default)."
        },
        "day.extraEnv": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra environment variables passed to every launch as `--env KEY=VALUE`."
        },
        "day.ohosNdkHome": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the OpenHarmony NDK `native` directory (e.g. `~/ohos-sdk/native`), exported as `OHOS_NDK_HOME` when building/launching the `ohos-arkui` target. Leave empty to auto-detect: the existing `OHOS_NDK_HOME`, then `~/ohos/ndk-extract/native`, then `~/ohos-sdk/native`. The SDK's sibling `toolchains/` directory (which carries `hdc`) is added to the task `PATH` as well."
        },
        "day.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Expose Day to AI agents via the Model Context Protocol (`day mcp-server`): build, launch, relaunch, and drive running apps, with screenshots agents can see."
        },
        "day.script.keepAppRunning": {
          "type": "boolean",
          "default": true,
          "description": "Keep the app running after a dayscript completes (interactive script development: extend the script and re-drive the live app). Turn off to restore terminate-on-completion, as CI does."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "day",
        "required": [
          "command",
          "target"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "launch"
            ],
            "description": "The day CLI subcommand to run."
          },
          "target": {
            "type": "string",
            "description": "The <os>-<toolkit> target (e.g. macos-appkit, ios-uikit)."
          },
          "profile": {
            "type": "string",
            "enum": [
              "debug",
              "release"
            ],
            "description": "Build mode."
          },
          "locale": {
            "type": "string",
            "description": "BCP-47 locale for --locale."
          },
          "script": {
            "type": "string",
            "description": "Dayscript file to run with --script."
          },
          "project": {
            "type": "string",
            "description": "Project directory (containing Day.toml)."
          },
          "keepAlive": {
            "type": "boolean",
            "description": "Keep the app running after its dayscript completes (default: the day.script.keepAppRunning setting)."
          }
        }
      }
    ],
    "problemPatterns": [
      {
        "name": "day-rustc-diagnostic",
        "patterns": [
          {
            "regexp": "^(warning|warn|error)(?:\\[(.*?)\\])?: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^[\\s->=]*(.*?):([1-9]\\d*):([1-9]\\d*)\\s*$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "problemMatchers": [
      {
        "name": "day-rustc",
        "label": "Rust compiler diagnostics from the day CLI",
        "owner": "day",
        "source": "rustc",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": "$day-rustc-diagnostic"
      },
      {
        "name": "day-rustc-watch",
        "label": "Rust diagnostics from a long-running day task",
        "owner": "day",
        "source": "rustc",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": "$day-rustc-diagnostic",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*(Building|Compiling)\\b",
          "endsPattern": "^\\s*(Built|Launching|Finished|error(\\[|:))"
        }
      }
    ],
    "configurationDefaults": {
      "evenBetterToml.schema.associations": {
        ".*/Day\\.toml$": "https://daybrite.dev/schema/day.toml.json"
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "day",
        "label": "Day — build, run, and drive Day apps"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  },
  "bugs": {
    "url": "https://github.com/daybrite/day-vscode/issues"
  },
  "homepage": "https://daybrite.dev",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Day builds and runs project code via the day CLI, which must not happen in Restricted Mode."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The day CLI needs the project on a real filesystem."
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
