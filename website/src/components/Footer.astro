---
import Logo from './Logo.astro';
import { site, url, dayDocs } from '../lib/site';
const year = new Date().getFullYear();
---
<footer>
  <div class="container inner">
    <div>
      <a class="brand" href={url()}><Logo size={22} /><span>Day for VS Code</span></a>
      <p>Part of the <a href={site.day}>Day</a> project.</p>
    </div>
    <div class="cols">
      <div>
        <h3>This extension</h3>
        <a href={url('docs/install')}>Install and update</a>
        <a href={url('docs/getting-started')}>Getting started</a>
        <a href={url('docs/reference')}>Commands and settings</a>
        <a href={url('docs/troubleshooting')}>Troubleshooting</a>
      </div>
      <div>
        <h3>The framework</h3>
        <a href={dayDocs('getting-started')}>Install the day CLI</a>
        <a href={dayDocs('cli')}>CLI reference</a>
        <a href={dayDocs('platforms')}>Targets</a>
        <a href={dayDocs('dayscript')}>dayscript</a>
      </div>
      <div>
        <h3>Source</h3>
        <a href={site.repo}>day-vscode</a>
        <a href="https://github.com/daybrite/day">day</a>
        <a href={site.repo + '/issues'}>Report an issue</a>
        <a href={site.repo + '/releases'}>Releases</a>
      </div>
    </div>
  </div>
  <div class="container legal"><span>© {year} Daybrite</span></div>
</footer>

<style>
  footer { border-top: 1px solid var(--border-soft); margin-top: 60px; padding-block: 46px 26px; background: var(--bg-2); }
  .inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 40px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; color: var(--text); font-weight: 700; }
  .inner p { color: var(--muted); font-size: 0.92rem; margin: 12px 0 0; max-width: 30ch; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 28px; }
  .cols h3 { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--faint); margin: 0 0 10px; }
  .cols a { display: block; color: var(--muted); font-size: 0.93rem; padding: 3px 0; }
  .cols a:hover { color: var(--text); }
  .legal { margin-top: 34px; padding-top: 18px; border-top: 1px solid var(--border-soft); color: var(--faint); font-size: 0.85rem; }
  @media (max-width: 760px) { .inner { grid-template-columns: 1fr; gap: 30px; } }
</style>
