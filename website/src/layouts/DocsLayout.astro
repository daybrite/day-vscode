---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url, dayDocs } from '../lib/site';

interface Props {
  title: string;
  description: string;
  slug: string;
}
const { title, description, slug } = Astro.props;

const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const sections: Record<string, typeof pages> = {};
for (const p of pages) (sections[p.data.section] ??= []).push(p);

// The framework's own documentation sits in the sidebar beside this extension's, so the line
// between them is visible instead of something a reader discovers by clicking.
const dayLinks: [string, string][] = [
  ['Install the CLI', 'getting-started'],
  ['CLI reference', 'cli'],
  ['Platforms and targets', 'platforms'],
  ['dayscript', 'dayscript'],
  ['Project structure', 'project-structure'],
  ['Day for agents', 'for-agents'],
];
---
<BaseLayout title={title} description={description} active={slug}>
  <div class="container docs">
    <nav class="docs-nav" aria-label="Documentation">
      {Object.entries(sections).map(([name, items]) => (
        <>
          <h2>{name}</h2>
          {items.map((p) => (
            <a href={url(`docs/${p.id}`)} aria-current={p.id === slug ? 'page' : undefined}>
              {p.data.title}
            </a>
          ))}
        </>
      ))}
      <h2>Day framework</h2>
      {dayLinks.map(([label, s]) => (
        <a class="ext" href={dayDocs(s)}>{label}</a>
      ))}
    </nav>
    <article class="prose"><slot /></article>
  </div>
</BaseLayout>

<style is:global>
  /* Screenshots in a docs page come as a light/dark pair and CSS picks — the same arrangement the
     gallery's <Shot> uses, spelled here because a markdown page cannot reach for a component.
     Dark is the base, so the dark capture is what shows until told otherwise, including when
     nothing has stamped `data-theme` because scripting is off. */
  .prose figure.shot {
    margin: 28px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .prose figure.shot img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .prose figure.shot img.only-light { display: none; }
  :root[data-theme='light'] .prose figure.shot img.only-light { display: block; }
  :root[data-theme='light'] .prose figure.shot img.only-dark { display: none; }
  .prose figure.shot figcaption {
    color: var(--faint);
    font-size: 0.88rem;
    line-height: 1.5;
  }
</style>
